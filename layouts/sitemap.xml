{{ "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ .Site.BaseURL }}</loc>
    <lastmod>{{ (now.UTC).Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</lastmod>
  </url>
  {{- range .Data.Pages }}
    {{- if and (not (in .Kind "taxonomy")) (not (in .Kind "term")) (ne .RelPermalink "/") }}
  <url>
    <loc>{{ .Permalink | absURL }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.UTC.Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
